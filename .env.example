NODE_ENV=development
PORT=3000
DATABASE_URL=mysql://mobiversite:mobiversite@localhost:3306/mobiversite
# Unset in development: 1234567891011121314151617181920212223242526272829303132
# Production requires a value of at least 32 characters.
# JWT_SECRET=
JWT_EXPIRES_IN_SECONDS=86400
# Origin of the mock, or the payments path. Both http://localhost:4000 and
# http://localhost:4000/payments are accepted.
PAYMENT_SERVICE_URL=http://localhost:4000
PAYMENT_WEBHOOK_SECRET=dev-webhook-secret
REFRESH_TOKEN_EXPIRES_IN_SECONDS=604800
RESERVATION_HOLD_MS=1800000
AUTH_RATE_LIMIT=10
AUTH_RATE_TTL_MS=60000
BOOKING_RATE_LIMIT=30
BOOKING_RATE_TTL_MS=60000
MAX_ACTIVE_TICKETS_PER_EVENT=10
# memory counts in this process. redis shares the counter across API instances.
RATE_LIMIT_STORE=memory
# REDIS_URL=redis://localhost:6379
# Hop count of reverse proxies in front of the API. 0 ignores X-Forwarded-For.
TRUST_PROXY=0
DATABASE_POOL_SIZE=20
# Set to false on extra API replicas so only one process runs the minute jobs.
RUN_JOBS=true
# Defaults to true outside production and false in production.
# SWAGGER_ENABLED=true
ADMIN_EMAIL=admin@mobiversite.local
ADMIN_PASSWORD=change-me-admin
