generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum Role {
  CUSTOMER
  ADMIN
}

enum BookingStatus {
  HELD
  PAID
  CANCELLED
  EXPIRED
}

model User {
  id           String    @id @default(uuid(7)) @db.Char(36)
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  bookings     Booking[]

  @@map("users")
}

model Event {
  id               String    @id @default(uuid(7)) @db.Char(36)
  title            String    @db.VarChar(200)
  description      String    @db.Text
  venue            String    @db.VarChar(200)
  startsAt         DateTime  @map("starts_at")
  ticketPrice      Decimal   @map("ticket_price") @db.Decimal(10, 2)
  totalTickets     Int       @map("total_tickets")
  availableTickets Int       @map("available_tickets")
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")
  deletedAt        DateTime? @map("deleted_at")
  bookings         Booking[]

  @@index([startsAt])
  @@map("events")
}

model Booking {
  id          String        @id @default(uuid(7)) @db.Char(36)
  userId      String        @map("user_id") @db.Char(36)
  eventId     String        @map("event_id") @db.Char(36)
  quantity    Int
  status      BookingStatus @default(HELD)
  ticketPrice Decimal       @map("ticket_price") @db.Decimal(10, 2)
  expiresAt   DateTime      @map("expires_at")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  user        User          @relation(fields: [userId], references: [id])
  event       Event         @relation(fields: [eventId], references: [id])

  @@index([userId, createdAt])
  @@index([eventId])
  @@index([status, expiresAt])
  @@map("bookings")
}
